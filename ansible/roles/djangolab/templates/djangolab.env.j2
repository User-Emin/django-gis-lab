# {{ ansible_managed }}
DJANGO_SETTINGS_MODULE=projectkaart.settings.prod
DJANGO_SECRET_KEY={{ djangolab_django_secret_key }}
DJANGO_ALLOWED_HOSTS={{ djangolab_allowed_hosts }}
DJANGO_SSL_REDIRECT=0
DJANGO_HSTS_SECONDS=0
DB_NAME={{ djangolab_db_name }}
DB_HOST={{ djangolab_db_host }}
DB_PORT={{ djangolab_db_port }}
{% if djangolab_gdal_library_path %}
GDAL_LIBRARY_PATH={{ djangolab_gdal_library_path }}
GEOS_LIBRARY_PATH={{ djangolab_geos_library_path }}
{% endif %}
